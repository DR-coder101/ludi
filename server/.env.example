# Server Configuration
PORT=3000

# LiveKit (M4 - Video chat)
# Get credentials from https://cloud.livekit.io/
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-project.livekit.cloud

# Supabase (M5.1 - Auth & match history)
# REQUIRED for guest auth and lobby functionality
# 
# Setup steps:
# 1. Create a Supabase project at https://supabase.com/dashboard
# 2. Enable Anonymous sign-ins:
#    - Go to Authentication → Providers
#    - Enable "Anonymous sign-ins"
# 3. Run the database schema:
#    - Go to SQL Editor
#    - Copy and run server/database/schema.sql
# 4. Get your credentials from:
#    - Settings → API
#    - Copy "Project URL" and "service_role" key (NOT the anon key)
#
# Get credentials from https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# IMPORTANT: Never commit .env with real credentials
# The service role key grants admin access - keep it secret, server-side only
