{
  "name": "ludi-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Caribbean (Jamaican) Ludo — Expo + Socket.IO monorepo",
  "scripts": {
    "dev:server": "pnpm --filter server dev",
    "dev:mobile": "pnpm --filter mobile dev",
    "dev": "pnpm --parallel --filter server --filter mobile dev",
    "test": "pnpm -r test",
    "test:rules": "pnpm --filter @ludi/rules test",
    "lint": "pnpm -r lint",
    "build": "pnpm -r build"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "ludo",
    "jamaican-ludo",
    "caribbean",
    "multiplayer",
    "mobile-game"
  ],
  "author": "Dean",
  "license": "UNLICENSED"
}
