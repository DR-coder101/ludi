#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
if [[ -x "$ROOT/node_modules/.bin/tsx" ]]; then
  exec "$ROOT/node_modules/.bin/tsx" "$ROOT/src/cli.ts" "$@"
fi
if [[ -x "$ROOT/../../node_modules/.bin/tsx" ]]; then
  exec "$ROOT/../../node_modules/.bin/tsx" "$ROOT/src/cli.ts" "$@"
fi
exec pnpm --dir "$ROOT" exec tsx "$ROOT/src/cli.ts" "$@"
