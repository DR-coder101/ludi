{
  "name": "@ludi/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-friendly CLI that drives the Ludi server (HTTP + Socket.IO) for verification",
  "bin": {
    "ludi": "./bin/ludi"
  },
  "scripts": {
    "ludi": "tsx src/cli.ts",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ludi/protocol": "workspace:*",
    "@ludi/rules": "workspace:*",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9"
  }
}
