{
  "name": "live-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ludi Live streamer admin panel and connector host",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
    "start": "tsx src/host/index.ts",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "pack:win": "node scripts/pack-win.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.2.6",
    "@ludi/live-connector": "workspace:*",
    "@ludi/live-game": "workspace:*",
    "@ludi/protocol": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@yao-pkg/pkg": "^6.5.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
