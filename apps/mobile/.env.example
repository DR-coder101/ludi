# Socket Server URL
# Default (when unset): https://server-production-3749.up.railway.app
# For local development: http://localhost:3000
# For physical device on same network: http://192.168.1.x:3000 (replace with your IP)
EXPO_PUBLIC_SOCKET_URL=https://server-production-3749.up.railway.app

# NOTE: Supabase auth is handled server-side only.
# The mobile app does not need SUPABASE_URL or SUPABASE_ANON_KEY.
# Guest auth and all auth flows go through server HTTP endpoints (/auth/guest, /auth/signup, etc.).
